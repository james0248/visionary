# Privilege escalation
prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Do not run privileged commands automatically.",
)

prefix_rule(
    pattern = ["su"],
    decision = "forbidden",
    justification = "Do not switch users automatically.",
)

# Dangerous recursive deletion
prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Never recursively delete the root filesystem.",
)

prefix_rule(
    pattern = ["rm", "-rf", "~"],
    decision = "forbidden",
    justification = "Never recursively delete the home directory.",
)

prefix_rule(
    pattern = ["rm", "-rf", "$HOME"],
    decision = "forbidden",
    justification = "Never recursively delete the home directory.",
)

prefix_rule(
    pattern = ["rm", "-rf", "."],
    decision = "forbidden",
    justification = "Do not recursively delete the current working directory.",
)

prefix_rule(
    pattern = ["rm", "-rf", ".."],
    decision = "forbidden",
    justification = "Do not recursively delete the parent directory.",
)

prefix_rule(
    pattern = ["rm", "-rf", "*"],
    decision = "forbidden",
    justification = "Do not recursively delete everything via wildcard.",
)

# Common variants with -fr
prefix_rule(
    pattern = ["rm", "-fr", "/"],
    decision = "forbidden",
    justification = "Never recursively delete the root filesystem.",
)

prefix_rule(
    pattern = ["rm", "-fr", "."],
    decision = "forbidden",
    justification = "Do not recursively delete the current working directory.",
)

prefix_rule(
    pattern = ["rm", "-fr", ".."],
    decision = "forbidden",
    justification = "Do not recursively delete the parent directory.",
)

# Raw disk / filesystem operations
prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "Do not run raw disk operations automatically.",
)

prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "Do not format filesystems automatically.",
)

prefix_rule(
    pattern = ["mkfs.ext4"],
    decision = "forbidden",
    justification = "Do not format filesystems automatically.",
)

prefix_rule(
    pattern = ["mkfs.xfs"],
    decision = "forbidden",
    justification = "Do not format filesystems automatically.",
)

prefix_rule(
    pattern = ["mkfs.btrfs"],
    decision = "forbidden",
    justification = "Do not format filesystems automatically.",
)

prefix_rule(
    pattern = ["mount"],
    decision = "forbidden",
    justification = "Do not mount filesystems automatically.",
)

prefix_rule(
    pattern = ["umount"],
    decision = "forbidden",
    justification = "Do not unmount filesystems automatically.",
)

# Broad permission / ownership changes
prefix_rule(
    pattern = ["chmod", "-R", "/"],
    decision = "forbidden",
    justification = "Do not recursively chmod the root filesystem.",
)

prefix_rule(
    pattern = ["chown", "-R", "/"],
    decision = "forbidden",
    justification = "Do not recursively chown the root filesystem.",
)

prefix_rule(
    pattern = ["chmod", "-R", "777"],
    decision = "forbidden",
    justification = "Do not recursively make files world-writable automatically.",
)