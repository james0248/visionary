{
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:webgpu:browser": "bun scripts/build_browser_entrypoints.ts",
    "benchmark:webgpu": "bun scripts/run_playwright_chrome_home.ts test bench/run_webgpu_benchmark.spec.ts --project=chromium",
    "benchmark:webgpu:ci": "bun scripts/run_playwright_chrome_home.ts test bench/run_webgpu_benchmark.spec.ts --project=chromium && uv run python bench/check_webgpu_benchmark.py --result bench/results/latest.json --baseline bench/baselines/webgpu_benchmark_baseline.json",
    "benchmark:webgpu:headless-smoke": "bun scripts/run_playwright_chrome_home.ts test bench/run_webgpu_benchmark.spec.ts --project=chromium --grep @smoke --allow-software-webgpu --playwright-headless 1",
    "benchmark:webgpu:smoke": "bun scripts/run_playwright_chrome_home.ts test bench/run_webgpu_benchmark.spec.ts --project=chromium --grep @smoke",
    "benchmark:wasm:chrome": "bun scripts/run_playwright_chrome_home.ts test bench/run_webgpu_benchmark.spec.ts --project=chromium --grep @output_validation --playwright-channel chrome --webgpu-benchmark-provider wasm",
    "benchmark:wasm:webkit": "bun scripts/run_playwright_chrome_home.ts test bench/run_webgpu_benchmark.spec.ts --project=webkit --grep @output_validation --webgpu-benchmark-provider wasm",
    "benchmark:wasm:all": "bun run benchmark:wasm:chrome && bun run benchmark:wasm:webkit",
    "clean:generated": "bun scripts/clean_generated.ts",
    "demo:webgpu:build": "bun scripts/build_demo_site.ts",
    "demo:webgpu": "bun scripts/serve_static.ts --host 127.0.0.1 --port 4173",
    "demo:webgpu:smoke": "bun scripts/run_playwright_chrome_home.ts test demo/run_demo_smoke.spec.ts --project=chromium --grep @demo",
    "demo:validate-cache-fill": "bun scripts/validate_demo_cache_fill.ts",
    "demo:validate-output": "bun scripts/validate_demo_bricks.ts"
  },
  "dependencies": {
    "onnxruntime-web": "^1.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.13",
    "@webgpu/types": "^0.1.69",
    "typescript": "^6.0.3"
  }
}
