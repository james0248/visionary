{
  "type": "module",
  "scripts": {
    "benchmark:webgpu": "node scripts/webgpu/run_playwright_chrome_home.mjs test webgpu_app/bench/run_webgpu_benchmark.spec.js --project=chromium",
    "benchmark:webgpu:ci": "node scripts/webgpu/run_playwright_chrome_home.mjs test webgpu_app/bench/run_webgpu_benchmark.spec.js --project=chromium && uv run python scripts/webgpu/check_webgpu_benchmark.py --result webgpu_app/bench/results/latest.json --baseline webgpu_app/bench/baselines/webgpu_benchmark_baseline.json",
    "benchmark:webgpu:headless-smoke": "ALLOW_SOFTWARE_WEBGPU=1 PLAYWRIGHT_HEADLESS=1 playwright test webgpu_app/bench/run_webgpu_benchmark.spec.js --project=chromium --grep @smoke",
    "benchmark:webgpu:smoke": "node scripts/webgpu/run_playwright_chrome_home.mjs test webgpu_app/bench/run_webgpu_benchmark.spec.js --project=chromium --grep @smoke",
    "demo:webgpu:build": "node scripts/webgpu/build_demo_site.mjs",
    "demo:webgpu": "node scripts/webgpu/serve_static.mjs --host 127.0.0.1 --port 4173",
    "demo:webgpu:smoke": "node scripts/webgpu/run_playwright_chrome_home.mjs test webgpu_app/demo/run_demo_smoke.spec.js --project=chromium --grep @demo"
  },
  "dependencies": {
    "onnxruntime-web": "^1.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
