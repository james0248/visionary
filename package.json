{
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:webgpu:browser": "bun scripts/webgpu/build_browser_entrypoints.ts",
    "benchmark:webgpu": "bun scripts/webgpu/run_playwright_chrome_home.ts test webgpu_app/bench/run_webgpu_benchmark.spec.ts --project=chromium",
    "benchmark:webgpu:ci": "bun scripts/webgpu/run_playwright_chrome_home.ts test webgpu_app/bench/run_webgpu_benchmark.spec.ts --project=chromium && uv run python scripts/webgpu/check_webgpu_benchmark.py --result webgpu_app/bench/results/latest.json --baseline webgpu_app/bench/baselines/webgpu_benchmark_baseline.json",
    "benchmark:webgpu:headless-smoke": "ALLOW_SOFTWARE_WEBGPU=1 PLAYWRIGHT_HEADLESS=1 playwright test webgpu_app/bench/run_webgpu_benchmark.spec.ts --project=chromium --grep @smoke",
    "benchmark:webgpu:smoke": "bun scripts/webgpu/run_playwright_chrome_home.ts test webgpu_app/bench/run_webgpu_benchmark.spec.ts --project=chromium --grep @smoke",
    "demo:webgpu:build": "bun scripts/webgpu/build_demo_site.ts",
    "demo:webgpu": "bun scripts/webgpu/serve_static.ts --host 127.0.0.1 --port 4173",
    "demo:webgpu:smoke": "bun scripts/webgpu/run_playwright_chrome_home.ts test webgpu_app/demo/run_demo_smoke.spec.ts --project=chromium --grep @demo"
  },
  "dependencies": {
    "onnxruntime-web": "^1.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.13",
    "@webgpu/types": "^0.1.69",
    "typescript": "^6.0.3"
  }
}
